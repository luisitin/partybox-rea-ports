{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@partybox/shared": ["./packages/shared/src/index.ts"],
      "@partybox/game-sdk": ["./packages/game-sdk/src/index.ts"],
      "@partybox/game-sdk/match": ["./packages/game-sdk/src/match.ts"],
      "@partybox/game-sdk/ui": ["./packages/game-sdk/src/ui.ts"],
      "@partybox/game-sdk/speech": ["./packages/game-sdk/src/speech.ts"],
      "@partybox/game-sdk/ui/secret-card": ["./packages/game-sdk/src/ui-secret-card.ts"],
      "@partybox/game-sdk/ui/face-picker": ["./packages/game-sdk/src/ui-face-picker.ts"],
      "@partybox/game-sdk/ui/dial": ["./packages/game-sdk/src/ui-dial.ts"],
      "@partybox/game-sdk/ui/team-banner": ["./packages/game-sdk/src/ui-team-banner.ts"],
      "@partybox/game-sdk/ui/minigame": ["./packages/game-sdk/src/ui-minigame.ts"],
      "@partybox/game-sdk/rhythm": ["./packages/game-sdk/src/rhythm.ts"],
      "@partybox/game-sdk/ui/rhythm": ["./packages/game-sdk/src/ui-rhythm.ts"],
      "@partybox/game-sdk/kaboom": ["./packages/game-sdk/src/kaboom.ts"],
      "@partybox/game-sdk/ui/kaboom": ["./packages/game-sdk/src/ui-kaboom.ts"],
      "@partybox/game-sdk/ui/word-grid": ["./packages/game-sdk/src/ui-word-grid.ts"],
      "@partybox/game-sdk/ui/order-picker": ["./packages/game-sdk/src/ui-order-picker.ts"],
      "@partybox/game-sdk/ui/bid-pad": ["./packages/game-sdk/src/ui-bid-pad.ts"],
      "@partybox/game-sdk/ui/card-hand": ["./packages/game-sdk/src/ui-card-hand.ts"],
      "@partybox/game-sdk/pieces": ["./packages/game-sdk/src/pieces.ts"],
      "@partybox/game-sdk/ui/table3d": ["./packages/game-sdk/src/ui-table3d.ts"],
      "@partybox/game-sdk/testing": ["./packages/game-sdk/src/testing.ts"]
    }
  }
}
