@@ -0,0 +1,164 @@
+/* The native graph is centered; the full-width answer alternatives remain the reading anchor. */
+.chart {
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr) auto auto;
+  gap: var(--pb-space-3);
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  width: 100%;
+}
+.prompt {
+  justify-self: center;
+  max-width: 100%;
+  margin: 0;
+  padding: var(--pb-space-2) var(--pb-space-4);
+  border-radius: calc(var(--pb-radius) / 2);
+  background: var(--pb-surface);
+  color: var(--pb-text);
+  font-size: var(--pb-font-h2);
+  line-height: 1.15;
+  text-align: center;
+  text-wrap: balance;
+  overflow-wrap: anywhere;
+}
+.bars {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  align-self: center;
+  justify-self: center;
+  column-gap: var(--pb-space-7);
+  width: 60%;
+  max-width: calc(var(--pb-space-8) * 13);
+  height: 100%;
+  max-height: calc(var(--pb-space-8) * 4);
+  min-height: 0;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.column {
+  display: grid;
+  grid-template-rows: minmax(0, 1fr) auto;
+  min-height: 0;
+  min-width: 0;
+}
+.track {
+  position: relative;
+  min-height: 0;
+}
+.fill {
+  position: absolute;
+  inset-inline: 0;
+  bottom: 0;
+  height: calc(100% * var(--pb-group-chart-share));
+  border-radius: calc(var(--pb-radius) / 2) calc(var(--pb-radius) / 2) 0 0;
+}
+.base {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--pb-space-2);
+  padding: var(--pb-space-2);
+  border-radius: 0 0 calc(var(--pb-radius) / 2) calc(var(--pb-radius) / 2);
+  font-size: var(--pb-font-body);
+  line-height: 1.2;
+  font-variant-numeric: tabular-nums;
+}
+.base::before {
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  background: var(--pb-bg);
+  opacity: 0.18;
+  content: '';
+  pointer-events: none;
+}
+.base > * {
+  position: relative;
+}
+.shape {
+  flex: none;
+  width: var(--pb-font-body);
+  height: var(--pb-font-body);
+}
+.check {
+  font-size: var(--pb-font-body);
+  line-height: 1;
+  font-weight: 1000;
+}
+.choices {
+  min-width: 0;
+}
+.choices li {
+  min-height: 0;
+}
+.choices li[data-correct='false'] {
+  background: var(--pb-surface-2);
+  color: var(--pb-text-muted);
+}
+.choices li[data-correct='false'] > span:first-of-type {
+  text-decoration: line-through;
+}
+.footer {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: var(--pb-space-2) var(--pb-space-4);
+  min-width: 0;
+  font-size: var(--pb-font-body);
+  line-height: 1.2;
+}
+.footer > p {
+  flex-basis: 100%;
+  min-width: 0;
+  margin: 0;
+  font-size: inherit;
+}
+/* Phones retain the shared shapes and the original four alternatives on the SDK type scale. */
+:global([data-surface='phone']) .chart {
+  gap: var(--pb-space-2);
+}
+:global([data-surface='phone']) .prompt {
+  padding: var(--pb-space-1) var(--pb-space-2);
+  font-size: var(--pb-font-body);
+  line-height: 1.2;
+}
+:global([data-surface='phone']) .bars {
+  width: 100%;
+  max-width: none;
+  max-height: calc(var(--pb-space-8) * 2);
+  column-gap: var(--pb-space-2);
+}
+:global([data-surface='phone']) .base {
+  gap: var(--pb-space-1);
+  padding: var(--pb-space-1);
+  font-size: var(--pb-font-caption);
+}
+:global([data-surface='phone']) .shape,
+:global([data-surface='phone']) .check {
+  width: var(--pb-font-body);
+  height: var(--pb-font-body);
+  font-size: var(--pb-font-body);
+}
+:global([data-surface='phone']) .choices ol {
+  gap: var(--pb-space-2);
+}
+:global([data-surface='phone']) .choices li {
+  gap: var(--pb-space-2);
+  padding: var(--pb-space-2);
+  font-size: var(--pb-font-caption);
+}
+:global([data-surface='phone']) .choices svg {
+  width: var(--pb-font-h2);
+  height: var(--pb-font-h2);
+}
+:global([data-surface='phone']) .footer {
+  font-size: var(--pb-font-caption);
+}
+
+/* The phone Screen already supplies the round title; the TV keeps its native footer ordinal. */
+:global([data-surface='phone']) .ordinal {
+  display: none;
+}
